# ===================================================
# E-Cell VIT Mumbai — Environment Configuration
# 100% Local Setup — No Cloud Services or Accounts Required
# ===================================================

# SQLite Database connection string (relative to ./prisma folder)
DATABASE_URL="file:../data/ecell.db"

# Session encryption secret (minimum 32 random characters)
# Generate a fresh one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string-for-production"

# Application Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local Server Port (default 3000)
PORT="3000"
